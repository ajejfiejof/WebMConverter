  <name>WebMConverter</name>
  <summary>Convert and edit videos for the WebM format</summary>
  <description>
    <p>
      WebMConverter is a GUI wrapper around FFmpeg designed for converting and
      editing videos for WebM without needing command-line tools. It supports
      VP9, AV1 and legacy VP8 video with Opus or Vorbis audio, native FFmpeg
      filters (crop, trim, resize, subtitles, captions, rotate and more),
      ffplay previews and yt-dlp downloads.
    </p>
  </description>
  <launchable type="desktop-id">io.github.ajejfiejof.WebMConverter.desktop</launchable>
  <provides>
    <binary>WebMConverter.Avalonia</binary>
  </provides>
