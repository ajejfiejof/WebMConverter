{
  "app-id": "io.github.ajejfiejof.WebMConverter",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "WebMConverter.Avalonia",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--device=dri",
    "--filesystem=host",
    "--env=PATH=/app/lib/ffmpeg/bin:/usr/bin:/bin"
  ],
  "add-extensions": {
    "org.freedesktop.Platform.ffmpeg-full": {
      "directory": "lib/ffmpeg",
      "version": "24.08"
    }
  },
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.dotnet8"
  ],
  "modules": [
    {
      "name": "yt-dlp",
      "buildsystem": "simple",
      "build-commands": [
        "python3 -m pip install --no-build-isolation --prefix=/app yt-dlp"
      ]
    },
    {
      "name": "webmconverter",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
          "DOTNET_NOLOGO": "1"
        }
      },
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ],
      "build-commands": [
        "source /usr/lib/sdk/dotnet8/enable.sh",
        "dotnet publish WebMConverter.Avalonia/WebMConverter.Avalonia.csproj -c Release -r linux-x64 --self-contained true -o /app/publish",
        "ln -s /app/publish/WebMConverter.Avalonia /app/bin/WebMConverter.Avalonia",
        "install -Dm644 packaging/io.github.ajejfiejof.WebMConverter.desktop /app/share/applications/io.github.ajejfiejof.WebMConverter.desktop",
        "install -Dm644 packaging/io.github.ajejfiejof.WebMConverter.metainfo.xml /app/share/metainfo/io.github.ajejfiejof.WebMConverter.metainfo.xml",
        "install -Dm644 packaging/icon.png /app/share/icons/hicolor/256x256/apps/io.github.ajejfiejof.WebMConverter.png"
      ]
    }
  ]
}
